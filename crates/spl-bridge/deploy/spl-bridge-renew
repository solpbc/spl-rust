set -euo pipefail

LOCK_FILE="${RENEW_LOCK_FILE:-/run/spl-bridge-renew/renew.lock}"
exec 200>"$LOCK_FILE"
flock -n 200 || {
    echo "spl-bridge-renew is already running; skipping concurrent run" >&2
    exit 1
}

GENERATIONS_DIR="${GENERATIONS_DIR:-/etc/spl-bridge/tls-generations}"
LEGO="${LEGO:-lego}"
ACTIVATE="${ACTIVATE:-spl-bridge-activate}"
VERIFY_ADDR="${VERIFY_ADDR:-127.0.0.1:443}"
RELOAD_CMD="${RELOAD_CMD:-systemctl reload spl-bridge}"
LEGO_DIR="${LEGO_DIR:-/etc/spl-bridge/acme-production}"
DOMAIN="bridge.solstone.me"
ACME_PORT="${ACME_PORT:-127.0.0.1:8443}"
: "${EMAIL:?EMAIL must be configured in /etc/spl-bridge/renewal.env}"
RENEW_HOOK="${RENEW_HOOK:-/usr/local/libexec/spl-bridge-renew-hook}"
ACTIVATE_ARGS=()
if [ -n "${ACTIVATE_ROOTS:-}" ]; then
    ACTIVATE_ARGS+=(--control-tls-roots "$ACTIVATE_ROOTS")
fi

RUN_LEGO=1

if [ -e "${GENERATIONS_DIR}/pending" ]; then
    set +e
    "$ACTIVATE" \
        --generations-dir "$GENERATIONS_DIR" \
        --verify-addr "$VERIFY_ADDR" \
        --reload-cmd "$RELOAD_CMD" \
        "${ACTIVATE_ARGS[@]}" \
        --retry-pending
    ACTIVATE_STATUS=$?
    set -e

    if [ "$ACTIVATE_STATUS" -eq 0 ]; then
        exit 0
    elif [ "$ACTIVATE_STATUS" -eq 2 ]; then
        RUN_LEGO=1
    else
        exit "$ACTIVATE_STATUS"
    fi
fi

if [ "$RUN_LEGO" -eq 1 ]; then
    "$LEGO" \
        --email "$EMAIL" \
        --domains "$DOMAIN" \
        --tls \
        --tls.port "$ACME_PORT" \
        --path "$LEGO_DIR" \
        renew --days 30 --renew-hook "$RENEW_HOOK"
fi

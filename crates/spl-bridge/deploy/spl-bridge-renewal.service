[Unit]
Description=SPL Bridge ACME Certificate Renewal
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=USER
Group=GROUP
ExecStart=/usr/local/bin/spl-bridge-renew
Restart=on-failure
RestartSec=6h
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
